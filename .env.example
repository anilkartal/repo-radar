# Fine-grained token; read access to public repos is enough
GITHUB_TOKEN=

# Summary provider: gemini (free tier) or anthropic
SUMMARY_PROVIDER=gemini
# Free key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Only needed when SUMMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model ID for the chosen provider (gemini-3.5-flash-lite was fast and free-tier available on 2026-11-14; claude-haiku-5-5 for anthropic)
SUMMARY_MODEL=gemini-3.5-flash-lite

# Optional tuning (defaults: gemini 1 / 4000ms, anthropic 3 / 0ms)
# SUMMARY_CONCURRENCY=1
# SUMMARY_MIN_INTERVAL_MS=4000
# SUMMARY_REASONING_EFFORT=low
